{
  "projectId": "prj_Y3uYkBOV1e83UDj8BKHtNGRkPe6n",
  "orgId": "team_Si8axloSzllikGpCs4P2RcYb",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
